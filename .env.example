# Copy to .env and adjust. Never commit .env.
# Shared by docker compose and Spring.
DB_NAME=example
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_URL=jdbc:postgresql://localhost:5433/example
REDIS_PORT=6380

# At least 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=replace-with-random-secret-min-32-bytes
JWT_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# Attempts per minute.
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=5

# Set to false in production.
SWAGGER_UI=true

# Observability. The app only talks to the collector; it fans out to Loki and Tempo.
OTLP_ENDPOINT=http://localhost:4318
# Never 1.0 in production.
TRACE_SAMPLING=1.0
# Structured console format: ecs or logstash. Must not be empty.
LOG_FORMAT=ecs
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317
ALLOY_UI_PORT=12345
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
