// Receives OTLP from the app, reshapes logs, then fans out: traces to Tempo, logs to Loki.
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces = [otelcol.processor.filter.traces.input]
    logs   = [otelcol.processor.filter.logs.input]
  }
}

// Connection pools and Lettuce emit parentless spans of their own (hello, info, client,
// connection). As children inside a real request they are useful, so only the orphans go.
otelcol.processor.filter "traces" {
  error_mode = "ignore"

  traces {
    span = [
      `parent_span_id.string == "0000000000000000" and name == "hello"`,
      `parent_span_id.string == "0000000000000000" and name == "info"`,
      `parent_span_id.string == "0000000000000000" and name == "client"`,
      `parent_span_id.string == "0000000000000000" and name == "connection"`,
    ]
  }

  output { traces = [otelcol.processor.tail_sampling.drop_noise.input] }
}

// Drops whole traces for infrastructure endpoints (health checks, docs polling). A plain span
// filter would strip the root span and leave orphaned children, so the decision is per trace.
otelcol.processor.tail_sampling "drop_noise" {
  decision_wait = "5s"

  policy {
    name = "keep-everything-but-infra-endpoints"
    type = "string_attribute"

    string_attribute {
      // Micrometer names the attribute "uri", not the OTel semconv "url.path".
      key                    = "uri"
      values                 = ["/actuator/.*", "/v3/api-docs.*", "/swagger-ui.*"]
      enabled_regex_matching = true
      invert_match           = true
    }
  }

  output { traces = [otelcol.processor.batch.default.input] }
}

// Only TRACE is dropped here. Volume control belongs on the app side (AUTH_LOG_LEVEL), where it
// can be flipped per package; filtering DEBUG here would hide it exactly when it is turned on.
otelcol.processor.filter "logs" {
  error_mode = "ignore"

  logs {
    log_record = ["severity_number < SEVERITY_NUMBER_DEBUG"]
  }

  output { logs = [otelcol.processor.transform.logs.input] }
}

otelcol.processor.transform "logs" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
      // Keep the original message; body is overwritten below.
      `set(cache["message"], body)`,
      // Promote the level to an attribute so Loki can index it as a label.
      `set(attributes["level"], severity_text)`,
      `set(body, {
         "timestamp": FormatTime(time, "%Y-%m-%dT%H:%M:%S.%fZ"),
         "level":     severity_text,
         "logger":    instrumentation_scope.name,
         "thread":    attributes["thread.name"],
         "message":   cache["message"],
         "trace_id":  trace_id.string,
         "span_id":   span_id.string
       })`,
    ]
  }

  output { logs = [otelcol.processor.batch.default.input] }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
    logs   = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
    tls { insecure = true }
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
    tls { insecure = true }
  }
}
