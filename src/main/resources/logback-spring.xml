<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!--
		defaults.xml sets the shared properties and converters. base.xml is deliberately NOT used:
		it pins a plain-text console appender and adds a FILE appender writing to /tmp/spring.log.
	-->
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>

	<!-- Fed by OpenTelemetryAppenderInstaller once the Spring context is up. -->
	<appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
		<captureExperimentalAttributes>true</captureExperimentalAttributes>
		<captureMdcAttributes>*</captureMdcAttributes>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="OTEL"/>
	</root>
</configuration>
